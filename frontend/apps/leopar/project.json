{
	"name": "leopar",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"prefix": "app",
	"sourceRoot": "apps/leopar/src",
	"tags": [],
	"targets": {
		"build": {
			"executor": "@angular-devkit/build-angular:application",
			"outputs": ["{options.outputPath}"],
			"options": {
				"outputPath": "dist/apps/leopar",
				"index": "apps/leopar/src/index.html",
				"browser": "apps/leopar/src/main.ts",
				"polyfills": [],
				"tsConfig": "apps/leopar/tsconfig.app.json",
				"inlineStyleLanguage": "css",
				"assets": [
					{
						"glob": "**/*",
						"input": "apps/leopar/public"
					},
					{
						"glob": "favicon.ico",
						"input": "apps/leopar/src"
					},
					{
						"glob": "**/*",
						"input": "apps/leopar/src/assets",
						"output": "/assets"
					},
					{
						"glob": "**/*",
						"input": "libs/interviews/ui/assets",
						"output": "/assets/interviews/ui"
					},
					{
						"glob": "**/*",
						"input": "libs/articles/pages/assets",
						"output": "/assets/articles"
					},
					{
						"glob": "**/*",
						"input": "assets",
						"output": "/assets"
					}
				],
				"styles": ["apps/leopar/src/styles.css"],
				"scripts": []
			},
			"configurations": {
				"production": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "1mb",
							"maximumError": "5mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "4kb",
							"maximumError": "8kb"
						}
					],
					"outputHashing": "all",
					"fileReplacements": [
						{
							"replace": "apps/leopar/src/environments/environment.ts",
							"with": "apps/leopar/src/environments/environment.production.ts"
						}
					],
					"sourceMap": true
				},
				"development": {
					"optimization": false,
					"extractLicenses": false,
					"sourceMap": true
				}
			},
			"defaultConfiguration": "production"
		},
		"serve": {
			"executor": "@angular-devkit/build-angular:dev-server",
			"configurations": {
				"production": {
					"buildTarget": "leopar:build:production"
				},
				"development": {
					"buildTarget": "leopar:build:development"
				},
				"leopar": {
					"buildTarget": "leopar:build:development",
					"fileReplacements": [
						{
							"replace": "frontend/apps/leopar/src/app/app.routes.config.ts",
							"with": "frontend/apps/leopar/src/app/leopar-app.routes.config.ts"
						}
					]
				}
			},
			"defaultConfiguration": "development",
			"continuous": true
		},
		"extract-i18n": {
			"executor": "@angular-devkit/build-angular:extract-i18n",
			"options": {
				"buildTarget": "leopar:build"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"serve-static": {
			"executor": "@nx/web:file-server",
			"options": {
				"buildTarget": "leopar:build",
				"port": 4200,
				"staticFilePath": "dist/apps/leopar/browser",
				"spa": true
			}
		},
		"test": {
			"executor": "@nx/vitest:test",
			"outputs": ["{options.reportsDirectory}"],
			"options": {
				"reportsDirectory": "../../coverage/apps/leopar"
			}
		}
	}
}
